rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAluStudentEmail() {
      return request.resource.data.email is string
        && request.resource.data.email.matches('(?i)^[a-z]\\.[^@\\s]+@alustudent\\.com$');
    }

    function isStaff() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isReporterEditingSubmitted() {
      return isSignedIn()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'category', 'location', 'updatedAt']);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && isAluStudentEmail();
      allow update, delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow update: if isStaff() || isReporterEditingSubmitted();
      allow delete: if isSignedIn()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'submitted';
    }
  }
}
